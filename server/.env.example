# Local dev reaches the private RDS instance through `npm run tunnel`.
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=netflix
PGUSER=app_api
# Wrap in single quotes if the password has special characters.
PGPASSWORD=
RDS_HOST=your-instance.xxxxxxxx.us-west-2.rds.amazonaws.com
BASTION_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
PORT=3001
